    "@evactis-3dworkflow/schema": "workspace:*",
    "@evactis-3dworkflow/viewer": "workspace:*",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
