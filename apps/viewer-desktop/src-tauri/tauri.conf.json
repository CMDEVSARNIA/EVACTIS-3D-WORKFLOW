{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EVACTIS 3DWORKFLOW Viewer",
  "mainBinaryName": "EVACTIS-3DWORKFLOW-Viewer",
  "version": "../package.json",
  "identifier": "ca.evactis.3dworkflow.viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Evactis",
    "copyright": "© 2026 Evactis",
    "category": "Productivity",
    "shortDescription": "Offline player for EVACTIS 3DWORKFLOW interactive facility environments.",
    "longDescription": "Offline player for EVACTIS 3DWORKFLOW interactive facility environments. Runs entirely offline on the client's own hardware.",
    "licenseFile": "../../../packaging/windows/LICENSE-EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/evx.ico": "filetypes/evx.ico",
      "icons/evxproj.ico": "filetypes/evxproj.ico",
      "../../../docs/licenses.md": "licenses.md"
    },
    "fileAssociations": [
      {
        "ext": [
          "evx"
        ],
        "name": "Evactis.3DWORKFLOW.Environment",
        "description": "EVACTIS 3DWORKFLOW Environment",
        "role": "Viewer",
        "mimeType": "application/vnd.evactis.3dworkflow.environment"
      }
    ],
    "createUpdaterArtifacts": false,
    "useLocalToolsDir": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "both",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "EVACTIS 3DWORKFLOW",
        "headerImage": "windows/nsis-header.bmp",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      },
      "wix": {
        "template": "windows/main.wxs",
        "upgradeCode": "31227426-D911-4A16-AC52-B73EF932C17F",
        "language": [
          "en-US",
          "fr-FR"
        ],
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    }
  }
}
