{
  "name": "@evactis-3dworkflow/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "EVACTIS 3DWORKFLOW Viewer core: framework-free, offline 360° environment player (Three.js).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.ts",
    "./dist/evactis-viewer.js"
  ],
  "main": "./dist/evactis-viewer.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/evactis-viewer.js"
    },
    "./viewer.css": "./dist/evactis-viewer.css",
    "./cube": "./src/panorama/cube.ts",
    "./player/*": "./player-dist/*"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && vite build --config demo/vite.config.ts && vite build --config player/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "@evactis-3dworkflow/brand": "workspace:*",
    "@evactis-3dworkflow/print": "workspace:*",
    "@evactis-3dworkflow/schema": "workspace:*",
    "pdfjs-dist": "4.10.38",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@evactis-3dworkflow/demo-facility": "workspace:*",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
